{
  "name": "edugen",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "prototype": "node apps/prototype/server.mjs",
    "prototype:test": "node --test apps/prototype/test.mjs",
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm prototype:test && pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @edugen/api db:generate",
    "db:migrate": "pnpm --filter @edugen/api db:migrate",
    "db:migrate:dev": "pnpm --filter @edugen/api db:migrate:dev",
    "db:deploy": "pnpm --filter @edugen/api db:deploy",
    "db:seed": "pnpm --filter @edugen/api db:seed",
    "db:studio": "pnpm --filter @edugen/api db:studio",
    "db:reset": "pnpm --filter @edugen/api db:reset"
  },
  "engines": {
    "node": ">=20.9"
  },
  "devDependencies": {
    "prisma": "^6.14.0"
  }
}
